# AOHP: Linux IPC the Android GKI base config leaves out. The Debian/Fedora env runs ordinary Linux software
# (Steam's tier0, PostgreSQL, RMDS-style daemons, ipcs tooling) that expects SysV semaphores/shm/msg queues and
# POSIX message queues; without them those syscalls return ENOSYS.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_IPC_NS=y

# PID namespaces. The GKI base leaves CONFIG_PID_NS off (Android has no use for it); without it
# /proc/self/ns/pid does not exist and software that reasons about process identity across restarts
# (OpenClaw's gateway state-ownership lease since 2026.11, any container runtime) has nothing to
# compare. Every process still shares the initial namespace until something unshares one.
CONFIG_PID_NS=y
