# AOHP: Linux IPC the Android GKI base config leaves out. The Debian/Fedora env runs ordinary Linux software
# (Steam's tier0, PostgreSQL, RMDS-style daemons, ipcs tooling) that expects SysV semaphores/shm/msg queues and
# POSIX message queues; without them those syscalls return ENOSYS.
CONFIG_SYSVIPC=y
CONFIG_SYSVIPC_SYSCTL=y
CONFIG_SYSVIPC_COMPAT=y
CONFIG_POSIX_MQUEUE=y
CONFIG_POSIX_MQUEUE_SYSCTL=y
CONFIG_IPC_NS=y

# PID namespaces. The GKI base leaves CONFIG_PID_NS off (Android has no use for it); without it
# /proc/self/ns/pid does not exist and software that reasons about process identity across restarts
# (OpenClaw's gateway state-ownership lease since 2026.11, any container runtime) has nothing to
# compare. Every process still shares the initial namespace until something unshares one.
CONFIG_PID_NS=y

# OCI container runtimes in the env (Podman/Docker): the rest of moby contrib/check-config.sh's
# "generally necessary" list plus what their default bridge network and resource limits use.
# Already on in the GKI base: NET/UTS/CGROUP namespaces, cpu/cpuset/memcg/freezer cgroups, VETH, BRIDGE,
# OVERLAY_FS, IPv4 NAT/masquerade, conntrack, seccomp, BPF, KEYS.
CONFIG_USER_NS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y
CONFIG_MACVLAN=y
CONFIG_IPVLAN=y
# Debian's iptables is nft-backed; runc/netavark drive it through xtables-over-nftables (NFT_COMPAT).
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_COMPAT=y
CONFIG_NFT_CT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
